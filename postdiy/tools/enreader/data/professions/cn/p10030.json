    },
    {
      "chunks": [
        {
          "t": "As our company expanded",
          "m": "随着公司扩张"
        },
        {
          "t": "into Europe and Southeast Asia,",
          "m": "进入欧洲和东南亚"
        },
        {
          "t": "I needed to coordinate projects",
          "m": "我需要协调项目"
