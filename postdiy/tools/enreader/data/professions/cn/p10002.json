{
  "id": "p10002",
  "sents": [
    {
      "chunks": [
        {
          "t": "After receiving the customer's requirements,",
          "m": "收到客户的具体需求后"
        },
        {
          "t": "the next important step",
          "m": "下一项重要工作"
        },
        {
          "t": "is preparing a professional price quotation.",
          "m": "是准备一份专业的报价单"
        }
      ]
    },
    {
      "chunks": [
        {
          "t": "A clear quotation",
          "m": "清晰的报价"
        },
        {
          "t": "helps the buyer understand the costs",
          "m": "帮助买家了解成本"
        },
        {
          "t": "and make a purchasing decision.",
          "m": "并作出采购决定"
        }
      ]
    },
    {
      "chunks": [
        {
          "t": "Sophia works as an export sales representative",
          "m": "索菲娅担任外贸业务代表"
        },
        {
          "t": "for a furniture manufacturer in China.",
          "m": "供职于中国一家家具制造企业"
        }
      ]
    },
    {
      "chunks": [
        {
          "t": "A customer from Germany",
          "m": "一位德国客户"
        },
        {
          "t": "recently requested a quotation",
          "m": "最近要求提供报价"
        },
        {
          "t": "for 500 office chairs.",
          "m": "为500把办公椅"
        }
      ]
    },
    {
      "chunks": [
        {
          "t": "The buyer wanted to know",
