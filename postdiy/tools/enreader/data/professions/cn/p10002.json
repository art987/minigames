        },
        {
          "t": "the unit price,",
          "m": "单价"
        },
        {
          "t": "minimum order quantity,",
          "m": "最小起订量"
        },
        {
          "t": "production lead time,",
          "m": "生产周期"
        },
        {
          "t": "and available payment methods.",
          "m": "以及可用的付款方式"
        }
      ]
    },
    {
      "chunks": [
        {
