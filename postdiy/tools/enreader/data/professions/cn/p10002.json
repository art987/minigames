          "m": "在发送文件之前"
        },
        {
          "t": "she checked every figure carefully",
          "m": "她仔细核对了每个数字"
        },
        {
          "t": "to avoid misunderstandings.",
          "m": "以避免产生误解"
        }
      ]
    },
    {
      "chunks": [
        {
          "t": "She understood",
          "m": "她明白"
        },
        {
          "t": "that an accurate quotation",
          "m": "准确的报价"
        },
        {
          "t": "could build trust",
          "m": "能够建立信任"
        },
        {
          "t": "and help move the negotiation forward.",
          "m": "并推动谈判向前发展"
        }
      ]
    }
