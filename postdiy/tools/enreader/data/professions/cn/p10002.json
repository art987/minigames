          "m": "单价"
        },
        {
          "t": "total amount,",
          "m": "总金额"
        },
        {
          "t": "and quotation validity period.",
          "m": "以及报价有效期"
        }
      ]
    },
    {
      "chunks": [
        {
          "t": "She also explained the payment terms.",
          "m": "她还解释了付款条件"
        }
      ]
    },
    {
      "chunks": [
        {
