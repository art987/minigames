          "m": "支付30%的定金"
        },
        {
          "t": "before production,",
          "m": "在生产之前"
        },
        {
          "t": "with the remaining balance",
          "m": "剩余尾款"
        },
        {
          "t": "paid before shipment.",
          "m": "在发货前付清"
        }
      ]
    },
    {
      "chunks": [
        {
          "t": "Sophia clearly stated",
          "m": "索菲娅清楚说明了"
        },
        {
          "t": "the proposed delivery schedule",
          "m": "预计的交货时间"
        },
        {
          "t": "and the shipping conditions.",
          "m": "以及运输条件"
        }
      ]
    },
    {
      "chunks": [
        {
