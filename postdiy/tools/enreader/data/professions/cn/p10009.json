     "m": "我会确保"
    },
    {
     "t": "that the customer service team",
     "m": "客服团队"
    },
    {
     "t": "knows the campaign rules",
     "m": "清楚活动规则"
    },
    {
     "t": "before customers start asking questions.",
     "m": "赶在客户咨询之前"
