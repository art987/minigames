 "sents": [
  {
   "chunks": [
    {
     "t": "A successful product launch",
     "m": "成功的产品上线"
    },
    {
     "t": "requires more than",
     "m": "不只是"
    },
    {
     "t": "finishing the development work.",
     "m": "完成开发工作"
    }
   ]
  },
  {
   "chunks": [
    {
     "t": "The product manager needs to",
