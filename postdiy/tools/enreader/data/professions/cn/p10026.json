{
  "id": "p10026",
  "sents": [
    {
      "chunks": [
        {
          "t": "When a company enters a foreign market,",
          "m": "企业进入海外市场时"
        },
        {
          "t": "translating its website",
          "m": "只翻译网站"
        },
        {
          "t": "is not enough.",
          "m": "是不够的"
        }
      ]
    },
    {
      "chunks": [
        {
          "t": "Marketing content should also match",
          "m": "营销内容还应符合"
        },
        {
          "t": "local language habits, culture,",
          "m": "当地语言习惯与文化"
        },
        {
          "t": "and customer expectations.",
          "m": "和客户期望"
        }
      ]
    },
    {
      "chunks": [
        {
          "t": "Last month,",
          "m": "上个月"
        },
        {
          "t": "our team prepared a campaign",
          "m": "我们团队筹备活动"
        },
        {
          "t": "for customers in Japan.",
          "m": "面向日本客户"
        }
      ]
    },
    {
      "chunks": [
        {
          "t": "The original campaign",
          "m": "最初的活动文案"
        },
        {
          "t": "was written in English.",
          "m": "是用英语写的"
        }
      ]
    },
    {
      "chunks": [
        {
          "t": "It used direct language",
          "m": "它用直白的表达"
        },
        {
          "t": "and several jokes",
          "m": "和几个笑话"
        },
        {
          "t": "that worked well",
          "m": "效果不错"
        },
        {
          "t": "in the United States.",
          "m": "在美国市场"
        }
      ]
    },
    {
      "chunks": [
        {
          "t": "However, a simple translation",
          "m": "然而，简单直译"
        },
        {
          "t": "sounded unnatural in Japanese.",
          "m": "用日语读着不自然"
        }
      ]
    },
    {
      "chunks": [
        {
          "t": "Some expressions",
          "m": "一些表达"
        },
        {
          "t": "also carried meanings",
          "m": "还带有一些含义"
        },
        {
          "t": "that were not suitable",
          "m": "却并不适合"
        },
        {
          "t": "for the local audience.",
          "m": "对当地受众而言"
        }
      ]
    },
    {
      "chunks": [
        {
          "t": "I worked with",
          "m": "我和…合作"
        },
        {
          "t": "a local translator",
          "m": "一位本地译者"
        },
        {
          "t": "and a marketing specialist",
          "m": "和一位营销专家"
        },
        {
          "t": "to review the content.",
          "m": "一起审查内容"
        }
      ]
    },
    {
      "chunks": [
        {
          "t": "We changed the headlines,",
          "m": "我们修改了标题"
        },
        {
          "t": "adjusted the tone,",
          "m": "调整了语气"
        },
        {
          "t": "and replaced some examples with situations",
          "m": "并用场景替换部分例子"
        },
        {
          "t": "that Japanese customers could easily understand.",
          "m": "日本客户容易理解"
        }
      ]
    },
    {
      "chunks": [
        {
          "t": "We also checked",
          "m": "我们还检查了"
        },
        {
          "t": "product descriptions,",
          "m": "产品描述"
        },
        {
          "t": "payment information,",
          "m": "支付信息"
        },
        {
          "t": "and customer service messages.",
          "m": "和客服消息"
        }
      ]
    },
    {
      "chunks": [
        {
          "t": "Visual content needed attention too.",
          "m": "视觉内容也需关注"
        }
      ]
    },
    {
      "chunks": [
        {
          "t": "We reviewed the images, colors, and layout",
          "m": "我们检查了图片、颜色和版式"
        },
        {
          "t": "to make sure",
          "m": "确保"
        },
        {
          "t": "they were appropriate",
          "m": "它们是否合适"
        },
        {
          "t": "for the local market.",
          "m": "符合当地市场"
        }
      ]
    },
    {
      "chunks": [
        {
          "t": "The goal was not to change",
          "m": "目标不是改变"
        },
        {
          "t": "our brand identity,",
          "m": "品牌形象"
        },
        {
          "t": "but to communicate it",
          "m": "而是传达它"
        },
        {
          "t": "in a more familiar way.",
          "m": "用更亲切的方式"
        }
      ]
    },
    {
      "chunks": [
        {
          "t": "Before publishing the campaign,",
          "m": "发布活动之前"
        },
        {
          "t": "we asked a small group of local users",
          "m": "请来一小群当地用户"
        },
        {
          "t": "to review the new version.",
          "m": "审阅新版本"
        }
      ]
    },
    {
      "chunks": [
        {
          "t": "Their comments",
          "m": "他们的意见"
        },
        {
          "t": "helped us improve several details.",
          "m": "帮我们改进了一些细节"
        }
      ]
    },
    {
      "chunks": [
        {
          "t": "Effective localization goes beyond translation.",
          "m": "有效的本地化不止于翻译"
        }
      ]
    },
    {
      "chunks": [
        {
          "t": "It makes a brand feel",
          "m": "它让品牌显得"
        },
        {
          "t": "relevant and trustworthy",
          "m": "相关且值得信赖"
        },
        {
          "t": "to people in different markets.",
          "m": "对不同市场的人群"
        }
      ]
    }
  ]
}
