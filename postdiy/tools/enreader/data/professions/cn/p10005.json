  "sents": [
    {
      "chunks": [
        {
          "t": "Shipping delays and payment issues",
          "m": "运输延误和付款问题"
        },
        {
          "t": "are common challenges in international trade.",
          "m": "是国际贸易中常见的挑战"
        }
      ]
    },
    {
      "chunks": [
        {
          "t": "When problems occur,",
          "m": "当问题发生时"
        },
        {
          "t": "export sales representatives",
          "m": "外贸业务代表"
        },
        {
          "t": "need to communicate quickly,",
          "m": "需要迅速沟通"
        },
        {
          "t": "provide accurate information,",
          "m": "提供准确信息"
        },
        {
          "t": "and offer practical solutions.",
          "m": "并提出切实可行的解决方案"
        }
      ]
    },
    {
      "chunks": [
        {
          "t": "David works",
          "m": "大卫任职"
        },
        {
          "t": "for a Chinese furniture exporter.",
          "m": "于一家中国家具出口企业"
        }
      ]
    },
    {
      "chunks": [
        {
