      ]
    },
    {
      "chunks": [
        {
          "t": "According to the original schedule,",
          "m": "按照原定计划"
        },
        {
          "t": "the cargo",
          "m": "货物"
        },
        {
          "t": "was expected to arrive at the destination port",
