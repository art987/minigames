  {
   "chunks": [
    {
     "t": "Every morning,",
     "m": "每天早上"
    },
    {
     "t": "I review the performance of our online store",
     "m": "我先查看网店运营表现"
    },
    {
     "t": "before deciding what tasks to focus on.",
     "m": "再决定当天的工作重点"
    }
   ]
  },
  {
   "chunks": [
    {
     "t": "I usually start with",
     "m": "我通常先看"
    },
    {
     "t": "sales, orders, traffic, advertising costs,",
     "m": "销售额、订单、流量、广告费"
    },
    {
     "t": "and inventory levels.",
     "m": "以及库存水平"
    }
   ]
  },
  {
   "chunks": [
    {
     "t": "I compare the numbers",
     "m": "我会对比数据"
    },
    {
     "t": "with the previous day",
     "m": "和前一天比"
    },
    {
     "t": "and the same period last week",
     "m": "也和上周同期比"
    },
    {
     "t": "to identify unusual changes.",
     "m": "找出异常变化"
    }
   ]
  },
  {
   "chunks": [
    {
     "t": "If traffic increases",
     "m": "如果流量涨了"
    },
    {
     "t": "but sales remain flat,",
     "m": "销售额却没变"
    },
    {
     "t": "I check the product pages, prices, reviews,",
     "m": "我就查页面、价格和评价"
    },
    {
     "t": "and delivery information.",
     "m": "以及配送信息"
    }
   ]
  },
  {
   "chunks": [
    {
     "t": "A high number of clicks",
     "m": "点击量高"
    },
    {
     "t": "does not always mean",
     "m": "不一定代表"
    },
    {
     "t": "that a campaign is successful.",
     "m": "广告活动就成功"
    }
   ]
  },
  {
   "chunks": [
    {
     "t": "I also look at",
     "m": "我还会看"
    },
    {
     "t": "the advertising cost of sales",
     "m": "广告销售成本占比"
    },
    {
     "t": "to understand whether we are spending too much",
     "m": "判断广告费是否花得过多"
    },
    {
     "t": "to generate revenue.",
     "m": "来换取销售额"
    }
   ]
  },
  {
   "chunks": [
    {
     "t": "When I notice",
     "m": "当我发现"
    },
    {
     "t": "a sudden drop in sales,",
     "m": "销售额突然下滑"
    },
    {
     "t": "I first check whether",
     "m": "我先检查是不是"
    },
    {
     "t": "the product is out of stock",
     "m": "商品缺货了"
    },
    {
     "t": "or the listing has a problem.",
     "m": "还是详情页出了问题"
    }
   ]
  },
  {
   "chunks": [
    {
     "t": "Then I review",
     "m": "接着我会检查"
    },
    {
     "t": "recent promotions, competitor prices,",
     "m": "近期促销和竞品价格"
    },
    {
     "t": "and advertising changes.",
     "m": "以及广告调整"
    }
   ]
  },
  {
   "chunks": [
    {
